{
  "compilerOptions": {
    /* Project structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Environment */
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",

    /* Node typings */
    "types": ["node"],
    "lib": ["ES2020"],

    /* Interop */
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Strictness */
    "strict": true,
    "skipLibCheck": true,

    /* Debugging */
    "sourceMap": true,

    /* Safety */
    "noUncheckedIndexedAccess": true
  },

  "include": ["src"],
  "exclude": ["node_modules"]
}
